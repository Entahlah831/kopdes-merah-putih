# Template Konfigurasi Ramping Kopdes Merah Putih (51 Variabel)
# Disinkronkan 100% dengan AppConfig di internal/config/config.go.
# Rahasia sengaja dikosongkan di template ini; salin via scripts/promote_env.sh atau scripts/promote_env.ps1.

# --- Runtime, Network, Worker & SLO ---
APP_ENV=development
APP_TIMEZONE=Asia/Jakarta
API_PORT=8080
API_HOST_PORT=8080
UI_PORT=8081
WORKER_PORT=8082
WORKER_TICK_INTERVAL=60s
SLO_READ_P95_MS=300
SLO_WRITE_P95_MS=800
SLO_MAX_ERROR_RATE=0.005
ALLOWED_ORIGINS=http://127.0.0.1:8081
TRUSTED_PROXIES=127.0.0.1/32

# --- Database PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_HOST_PORT=5433
DB_NAME=kopdes_db
DB_USER=kopdes_app
DB_PASSWORD=
DB_SSLMODE=disable
POSTGRES_PASSWORD=

# --- Kriptografi & Sesi Autentikasi ---
AES_MASTER_KEY=
AES_PREVIOUS_KEYS=
BLIND_INDEX_SECRET=
SESSION_IDLE_TTL=30m
SESSION_ABS_TTL=12h
COOKIE_SECURE=auto
ALLOW_BEARER_AUTH=false
MFA_REQUIRED_ROLES=admin,bendahara
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# --- CAPTCHA, Stok, & Pembayaran QRIS / Kendali Ganda ---
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
PAYMENTS_ENABLED=true
REGISTRATION_ENABLED=true
ALLOW_PERSONAL_PAYMENT_PILOT=false
PILOT_MAX_PER_TX=500000
PILOT_MAX_PER_DAY=2000000
QRIS_UNIQUE_DIGITS=3
PAYMENT_EXPIRY_DURATION=15m
STOCK_HOLD_MINUTES=60
PENDING_LIMIT_PER_MEMBER=2
PENDING_LIMIT_GLOBAL=50
DUAL_CONTROL_BREAKGLASS_ENABLED=false

# --- Retensi PDP, Penyimpanan KYC/Bukti & Backup Terautentikasi ---
# PERLU VERIFIKASI HUKUM: sesuaikan masa simpan berkas ditolak dan bukti non-lunas dengan penasihat hukum
PDP_REJECTED_RETENTION_DAYS=30
STORAGE_KYC_DIR=./storage/kyc
STORAGE_BUKTI_DIR=./storage/bukti
BUKTI_RETENTION_DAYS=365
BACKUP_DIR=./backups
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
