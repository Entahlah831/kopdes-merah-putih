# ==============================================================================
# TEMPLATE KONFIGURASI LINGKUNGAN — KOPDES MERAH PUTIH (.env.example)
# Salin file ini menjadi '.env' di server atau lingkungan lokal Anda:
# cp .env.example .env
# ==============================================================================

# 1. Konfigurasi Server API / Web
APP_ENV=production
# Port HTTP Server API (Bebas diubah sesuai kebutuhan, contoh: 8080, 3000, 5000)
PORT=8080
APP_PORT=8080

# 2. Konfigurasi Port & Koneksi Database PostgreSQL 16
# Ubah port dan kredensial database di sini
DB_HOST=postgres
DB_PORT=5432
DB_USER=kopdes_app
DB_PASSWORD=ganti_dengan_password_kuat_disini_123!
DB_NAME=kopdes_db
DB_SSLMODE=disable

# DSN Penuh (Bisa dipakai langsung oleh Docker Compose atau PaaS)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

# 3. Kunci Keamanan & Kriptografi (Wajib Minimal 32-byte Hex Random)
# Generate kunci acak di terminal: openssl rand -hex 32
JWT_SECRET=ganti_dengan_32_byte_hex_random_untuk_jwt_token_auth
BLIND_INDEX_SECRET=ganti_dengan_32_byte_hex_random_untuk_hmac_sha256_pdp
AES_MASTER_KEY=ganti_dengan_32_byte_hex_random_untuk_aes_256_gcm_pdp
QRIS_SECRET=ganti_dengan_32_byte_hex_random_untuk_linear_probing_qris

# 4. Kebijakan Jaringan & Rate Limiter
# Domain frontend yang diizinkan mengakses API (dipisah koma)
ALLOWED_ORIGINS=https://app.kopdes.id,https://admin.kopdes.id,http://localhost:3000
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60

# 5. Konfigurasi Pembayaran QRIS Statis & Rekening Pengurus (Fokus Lokal)
# Izinkan rekening/QRIS statis atas nama pengurus yang diunggah oleh admin (mode pilot lokal)
ALLOW_PERSONAL_PAYMENT_PILOT=true
# Gunakan QRIS statis + kode unik (QRIS dinamis dinonaktifkan sementara)
QRIS_DYNAMIC_ENABLED=false

# 6. Retensi Data Sensitif Pendaftaran Ditolak (Perlu Verifikasi Hukum)
# Masa retensi berkas KYC dan formulir pendaftaran ditolak (30 hari sebelum dihapus permanen)
PDP_REJECTED_RETENTION_DAYS=30

