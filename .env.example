# Konfigurasi Server
PORT=8080

# PostgreSQL 16 DSN
DATABASE_URL=postgres://kopdes_app:kopdes_dev_password@127.0.0.1:5433/kopdes_db?sslmode=disable

# Rahasia Autentikasi & Kriptografi (Wajib minimal 32 karakter acak saat production)
JWT_SECRET=dev-super-secret-jwt-key-minimum-32bytes-long!
BLIND_INDEX_SECRET=dev-blind-index-hmac-sha256-secret-32b!
QRIS_SECRET=dev-qris-linear-probing-secret-32b-key!
