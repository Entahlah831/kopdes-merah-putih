# Profil Pengujian Set A (Port Standar) — KHUSUS DATABASE *_test SINTETIS
# JANGAN PERNAH digunakan di produksi.

# --- Runtime, Network, Worker & SLO ---
APP_ENV=test
APP_TIMEZONE=Asia/Jakarta
API_PORT=8080
API_HOST_PORT=8080
UI_PORT=8081
WORKER_PORT=8082
WORKER_TICK_INTERVAL=60s
SLO_READ_P95_MS=300
SLO_WRITE_P95_MS=800
SLO_MAX_ERROR_RATE=0.005
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8081,http://localhost:8081
TRUSTED_PROXIES=127.0.0.1/32

# --- Database PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_HOST_PORT=5433
DB_NAME=kopdes_test
DB_USER=kopdes_app
DB_PASSWORD=kopdes_test_setA_pass_123!
DB_SSLMODE=disable
POSTGRES_PASSWORD=kopdes_test_setA_pass_123!

# --- Kriptografi & Sesi Autentikasi (SINTETIS SET A) ---
AES_MASTER_KEY=v1:k1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_PREVIOUS_KEYS=
BLIND_INDEX_SECRET=setA_blind_index_0123456789abcdef0123456789abcdef
SESSION_IDLE_TTL=30m
SESSION_ABS_TTL=12h
COOKIE_SECURE=auto
ALLOW_BEARER_AUTH=true
MFA_REQUIRED_ROLES=admin,bendahara
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# --- CAPTCHA, Stok, & Pembayaran QRIS / Kendali Ganda ---
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
PAYMENTS_ENABLED=true
REGISTRATION_ENABLED=true
ALLOW_PERSONAL_PAYMENT_PILOT=false
PILOT_MAX_PER_TX=500000
PILOT_MAX_PER_DAY=2000000
QRIS_UNIQUE_DIGITS=3
PAYMENT_EXPIRY_DURATION=15m
STOCK_HOLD_MINUTES=60
PENDING_LIMIT_PER_MEMBER=2
PENDING_LIMIT_GLOBAL=50
DUAL_CONTROL_BREAKGLASS_ENABLED=false

# --- Retensi PDP, Penyimpanan KYC/Bukti & Backup Terautentikasi ---
PDP_REJECTED_RETENTION_DAYS=30
STORAGE_KYC_DIR=./storage/kyc_test_setA
STORAGE_BUKTI_DIR=./storage/bukti_test_setA
BUKTI_RETENTION_DAYS=365
BACKUP_DIR=./backups/test_setA
BACKUP_AGE_RECIPIENT=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqsetaaa
BACKUP_RETENTION_DAYS=30
