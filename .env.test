# Profil Pengujian Set A (Port Standar) — KHUSUS DATABASE *_test SINTETIS
# JANGAN PERNAH digunakan di produksi.

# --- Runtime & Network ---
APP_ENV=test
APP_TIMEZONE=Asia/Jakarta
API_PORT=8080
API_HOST_PORT=8080
METRICS_PORT=9100
METRICS_HOST_PORT=9100
PROMETHEUS_HOST_PORT=9090
ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUSTED_PROXIES=127.0.0.1/32

# --- Database PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONTAINER_PORT=5432
DB_HOST_PORT=5433
DB_BIND_HOST=127.0.0.1
DB_NAME=kopdes_test
DB_USER=kopdes_app
DB_PASSWORD=kopdes_test_setA_pass_123!
DB_SSLMODE=disable
DATABASE_URL=postgres://kopdes_app:kopdes_test_setA_pass_123!@127.0.0.1:5433/kopdes_test?sslmode=disable
DB_APP_ROLE=kopdes_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kopdes_test_setA_pass_123!
KOPDES_APP_PASSWORD=kopdes_test_setA_pass_123!
ALLOW_SUPERUSER_DB=false
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TX_TIMEOUT=30s

# --- Kriptografi & Autentikasi (SINTETIS SET A) ---
JWT_SECRET=setA_jwt_secret_key_0123456789abcdef0123456789abcdef
JWT_PREVIOUS_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=kopdes-merah-putih-testA
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_KEY_VERSION=v1
AES_KEY_ID=k1
AES_PREVIOUS_KEYS=
BLIND_INDEX_SECRET=setA_blind_index_0123456789abcdef0123456789abcdef
QRIS_SECRET=setA_qris_hmac_secret_0123456789abcdef0123456789abcd
METRICS_TOKEN=setA_metrics_bearer_token_0123456789abcdef0123456789
METRICS_PREVIOUS_TOKEN=
BCRYPT_COST=10

# --- MFA, Rate Limit, & HTTP Hardening ---
MFA_ISSUER=Kopdes Merah Putih TestA
MFA_MAX_ATTEMPTS=3
MFA_SESSION_TTL=5m
MFA_SETUP_TTL=10m
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60
RATE_LIMIT_MAX_CLIENTS=10000
MAX_BODY_BYTES=10485760
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# --- Pekerja Latar, Partisi, Retensi PDP, & Fitur Pembayaran ---
PARTITION_MONTHS_AHEAD=3
PARTITION_JOB_INTERVAL=24h
PDP_REJECTED_RETENTION_DAYS=30
PDP_PURGE_INTERVAL=24h
QRIS_DYNAMIC_ENABLED=false
ALLOW_PERSONAL_PAYMENT_PILOT=false
PILOT_DEFAULT_MAX_PER_TX=500000
PILOT_DEFAULT_MAX_PER_DAY=2000000
DUAL_APPROVAL_DEFAULT_THRESHOLD=500000

# --- Penyimpanan, Backup, Notifikasi & Uji ---
STORAGE_KYC_DIR=./storage/kyc_test_setA
MAX_KYC_UPLOAD_BYTES=5242880
BACKUP_DIR=./backups/test_setA
BACKUP_ENCRYPTION_KEY=setA_backup_enc_key_0123456789abcdef!
BACKUP_RETENTION_DAYS=30
NOTIFIER_PROVIDER=noop
WHATSAPP_API_KEY=
SMS_API_KEY=
WEBHOOK_SIGNING_SECRET=
TEST_DATABASE_URL=postgres://kopdes_app:kopdes_test_setA_pass_123!@127.0.0.1:5433/kopdes_test?sslmode=disable
