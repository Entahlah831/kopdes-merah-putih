# Profil Pengujian Set B (Port Non-Standar & Nilai Berbeda) — KHUSUS DATABASE *_test SINTETIS
# Membuktikan tidak ada konfigurasi/port/rahasia yang hardcoded. JANGAN digunakan di produksi.

# --- Runtime & Network ---
APP_ENV=test
APP_TIMEZONE=Asia/Jakarta
API_PORT=18080
API_HOST_PORT=18080
METRICS_PORT=19100
METRICS_HOST_PORT=19100
PROMETHEUS_HOST_PORT=19090
ALLOWED_ORIGINS=http://127.0.0.1:13000
TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8

# --- Database PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=15433
DB_CONTAINER_PORT=15432
DB_HOST_PORT=15433
DB_BIND_HOST=127.0.0.1
DB_NAME=kopdes_alt_test
DB_USER=kopdes_app
DB_PASSWORD=kopdes_test_setB_alt_pass_987!
DB_SSLMODE=disable
DATABASE_URL=postgres://kopdes_app:kopdes_test_setB_alt_pass_987!@127.0.0.1:15433/kopdes_alt_test?sslmode=disable
DB_APP_ROLE=kopdes_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kopdes_test_setB_alt_pass_987!
KOPDES_APP_PASSWORD=kopdes_test_setB_alt_pass_987!
ALLOW_SUPERUSER_DB=false
DB_POOL_MAX_CONNS=18
DB_POOL_MIN_CONNS=1
DB_STATEMENT_TIMEOUT=12s
DB_LOCK_TIMEOUT=4s
DB_IDLE_IN_TX_TIMEOUT=20s

# --- Kriptografi & Autentikasi (SINTETIS SET B - SEMUA BERBEDA DARI SET A) ---
JWT_SECRET=setB_alt_jwt_secret_fedcba9876543210fedcba9876543210
JWT_PREVIOUS_SECRET=setA_jwt_secret_key_0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS512
JWT_ISSUER=kopdes-merah-putih-testB
JWT_ACCESS_TTL=3m
JWT_REFRESH_TTL=48h
AES_MASTER_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
AES_KEY_VERSION=v2
AES_KEY_ID=k9
AES_PREVIOUS_KEYS=v1:k1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BLIND_INDEX_SECRET=setB_alt_blind_index_fedcba9876543210fedcba9876543210
QRIS_SECRET=setB_alt_qris_hmac_fedcba9876543210fedcba9876543210
METRICS_TOKEN=setB_alt_metrics_bearer_fedcba9876543210fedcba987654
METRICS_PREVIOUS_TOKEN=setA_metrics_bearer_token_0123456789abcdef0123456789
BCRYPT_COST=11

# --- MFA, Rate Limit, & HTTP Hardening ---
MFA_ISSUER=Kopdes Alt Test SetB
MFA_MAX_ATTEMPTS=4
MFA_SESSION_TTL=2m
MFA_SETUP_TTL=6m
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_DURATION=5m
RATE_LIMIT_RPS=45
RATE_LIMIT_BURST=90
RATE_LIMIT_MAX_CLIENTS=2500
MAX_BODY_BYTES=5242880
HTTP_READ_HEADER_TIMEOUT=3s
HTTP_READ_TIMEOUT=8s
HTTP_WRITE_TIMEOUT=12s
HTTP_IDLE_TIMEOUT=45s

# --- Pekerja Latar, Partisi, Retensi PDP, & Fitur Pembayaran ---
PARTITION_MONTHS_AHEAD=4
PARTITION_JOB_INTERVAL=12h
PDP_REJECTED_RETENTION_DAYS=45
PDP_PURGE_INTERVAL=12h
QRIS_DYNAMIC_ENABLED=false
ALLOW_PERSONAL_PAYMENT_PILOT=false
PILOT_DEFAULT_MAX_PER_TX=750000
PILOT_DEFAULT_MAX_PER_DAY=2500000
DUAL_APPROVAL_DEFAULT_THRESHOLD=300000

# --- Penyimpanan, Backup, Notifikasi & Uji ---
STORAGE_KYC_DIR=./storage/kyc_test_setB
MAX_KYC_UPLOAD_BYTES=2097152
BACKUP_DIR=./backups/test_setB
BACKUP_ENCRYPTION_KEY=setB_alt_backup_key_9876543210!
BACKUP_RETENTION_DAYS=14
NOTIFIER_PROVIDER=noop
WHATSAPP_API_KEY=
SMS_API_KEY=
WEBHOOK_SIGNING_SECRET=
TEST_ENV_FILE=.env.test.alt
TEST_DATABASE_URL=postgres://kopdes_app:kopdes_test_setB_alt_pass_987!@127.0.0.1:15433/kopdes_alt_test?sslmode=disable
