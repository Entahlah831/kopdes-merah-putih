{
  "version": "1.0.0",
  "description": "Skenario verifikasi langsung 1-to-1 untuk setiap klaim perilaku di docs/FRONTEND_GUIDE.md dan docs/BACKEND_GUIDE.md.",
  "scenarios": [
    {
      "claim_id": "CLAIM-HEALTH-01",
      "title": "Liveness & Readiness Probes (/healthz, /readyz)",
      "operation": "GET /healthz + GET /readyz",
      "steps": [
        {
          "name": "GET /healthz",
          "as_account": "unauthenticated",
          "method": "GET",
          "path": "/healthz",
          "expect_status": [200],
          "expect_json_contains": ["status", "UP"]
        },
        {
          "name": "GET /readyz",
          "as_account": "unauthenticated",
          "method": "GET",
          "path": "/readyz",
          "expect_status": [200],
          "expect_json_contains": ["status"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-METRICS-01",
      "title": "Proteksi Bearer Token /metrics (401 tanpa/JWT, 200 dengan METRICS_TOKEN)",
      "operation": "GET /metrics",
      "requires_metrics_token": true,
      "steps": [
        {
          "name": "GET /metrics tanpa token ditolak 401",
          "as_account": "unauthenticated",
          "method": "GET",
          "path": "/metrics",
          "expect_status": [401]
        },
        {
          "name": "GET /metrics dengan JWT anggota ditolak 401",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/metrics",
          "expect_status": [401]
        },
        {
          "name": "GET /metrics dengan METRICS_TOKEN berhasil 200",
          "as_account": "unauthenticated",
          "method": "GET",
          "path": "/metrics",
          "headers": {
            "Authorization": "Bearer {{metrics_token}}"
          },
          "expect_status": [200]
        }
      ]
    },
    {
      "claim_id": "CLAIM-HTTP-HARDENING-01",
      "title": "HTTP Hardening: X-Request-ID header dan penolakan JSON rusak",
      "operation": "GET /healthz + malformed JSON POST /api/v1/auth/login",
      "steps": [
        {
          "name": "X-Request-ID tersedia di header respons",
          "as_account": "unauthenticated",
          "method": "GET",
          "path": "/healthz",
          "expect_status": [200],
          "expect_header_present": ["X-Request-ID"]
        },
        {
          "name": "JSON terpotong ditolak HTTP 400 BAD_REQUEST",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "raw_body": "{\"email\":",
          "expect_status": [400],
          "expect_json_contains": ["BAD_REQUEST"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-VALIDATION-400-01",
      "title": "Envelope Error Validasi Input HTTP 400 BAD_REQUEST",
      "operation": "POST /api/v1/auth/login (payload kosong)",
      "steps": [
        {
          "name": "Payload kosong menghasilkan 400 BAD_REQUEST",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "body": {},
          "expect_status": [400],
          "expect_json_contains": ["BAD_REQUEST", "\"success\":false"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-AUTH-LOGIN-01",
      "title": "Login Non-MFA 200 dan Kredensial Salah 401 UNAUTHORIZED",
      "operation": "POST /api/v1/auth/login",
      "steps": [
        {
          "name": "Sandi salah ditolak 401 UNAUTHORIZED",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "body": {
            "email": "wrong.login@kopdes.test",
            "password": "SalahPassword123!"
          },
          "expect_status": [401],
          "expect_json_contains": ["UNAUTHORIZED"]
        },
        {
          "name": "Login anggota non-MFA berhasil 200 dengan JWT + Refresh Token",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "body": {
            "email": "anggota_a@kopdes-test.local",
            "password": "{{seed_password}}"
          },
          "expect_status": [200],
          "expect_json_contains": ["access_token", "refresh_token", "\"token_type\":\"Bearer\""]
        }
      ]
    },
    {
      "claim_id": "CLAIM-AUTH-ME-01",
      "title": "Profil Pengguna Terotentikasi (/auth/me)",
      "operation": "GET /api/v1/auth/me",
      "steps": [
        {
          "name": "Tanpa JWT ditolak 401",
          "as_account": "unauthenticated",
          "method": "GET",
          "path": "/api/v1/auth/me",
          "expect_status": [401]
        },
        {
          "name": "Dengan JWT anggota_a mengembalikan profil 200",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/auth/me",
          "expect_status": [200],
          "expect_json_contains": ["\"role\":\"anggota\"", "koperasi_id"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-AUTH-MFA-VERIFY-01",
      "title": "Alur Login 2 Langkah MFA TOTP (/auth/login -> /auth/mfa/verify)",
      "operation": "POST /api/v1/auth/mfa/verify",
      "steps": [
        {
          "name": "Login ketua_a memicu mfa_required=true",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "body": {
            "email": "ketua_a@kopdes-test.local",
            "password": "{{seed_password}}"
          },
          "expect_status": [200],
          "expect_json_contains": ["\"mfa_required\":true", "mfa_session_token"],
          "save_json": {
            "mfa_sess": "data.mfa_session_token"
          }
        },
        {
          "name": "Hitung kode TOTP jendela +30 detik",
          "action": "totp_for_email",
          "email": "ketua_a@kopdes-test.local",
          "offset_seconds": 30,
          "save_as": "ketua_totp"
        },
        {
          "name": "Verifikasi MFA mengembalikan access_token",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/mfa/verify",
          "body": {
            "mfa_session_token": "{{mfa_sess}}",
            "totp_code": "{{ketua_totp}}"
          },
          "expect_status": [200],
          "expect_json_contains": ["access_token", "refresh_token"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-AUTH-MFA-MANDATORY-01",
      "title": "Paksa Enrollment MFA Akun Istimewa (403 -> setup -> enable)",
      "operation": "POST /api/v1/auth/mfa/setup + /enable",
      "steps": [
        {
          "name": "Login admin_nomfa_a ditolak 403 MFA_MANDATORY_SETUP_REQUIRED",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "body": {
            "email": "admin_nomfa_a@kopdes-test.local",
            "password": "{{seed_password}}"
          },
          "expect_status": [403],
          "expect_json_contains": ["MFA_MANDATORY_SETUP_REQUIRED", "setup_token"],
          "save_json": {
            "setup_tok": "data.setup_token"
          }
        },
        {
          "name": "Setup MFA dengan setup_token mengembalikan secret Base32",
          "method": "POST",
          "path": "/api/v1/auth/mfa/setup",
          "token_var": "setup_tok",
          "body": {},
          "expect_status": [200],
          "expect_json_contains": ["secret", "qr_uri"],
          "save_json": {
            "mfa_sec": "data.secret"
          }
        },
        {
          "name": "Hitung kode TOTP dari secret baru",
          "action": "totp_for_secret",
          "secret_var": "mfa_sec",
          "save_as": "enable_code"
        },
        {
          "name": "Aktifkan MFA dan terima recovery_codes sekali pakai",
          "method": "POST",
          "path": "/api/v1/auth/mfa/enable",
          "token_var": "setup_tok",
          "body": {
            "secret": "{{mfa_sec}}",
            "totp_code": "{{enable_code}}"
          },
          "expect_status": [200],
          "expect_json_contains": ["recovery_codes"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-AUTH-REFRESH-REUSE-01",
      "title": "Rotasi Refresh Token & Pencabutan Sesi Saat Reuse Terdeteksi",
      "operation": "POST /api/v1/auth/refresh",
      "steps": [
        {
          "name": "Login operator_a memperoleh rt1",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "body": {
            "email": "operator_a@kopdes-test.local",
            "password": "{{seed_password}}"
          },
          "expect_status": [200],
          "save_json": {
            "rt1": "data.refresh_token"
          }
        },
        {
          "name": "Rotasi rt1 -> rt2 berhasil 200",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/refresh",
          "body": {
            "refresh_token": "{{rt1}}"
          },
          "expect_status": [200],
          "save_json": {
            "rt2": "data.refresh_token"
          }
        },
        {
          "name": "Replay rt1 ditolak 401 dan mencabut keluarga sesi",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/refresh",
          "body": {
            "refresh_token": "{{rt1}}"
          },
          "expect_status": [401]
        },
        {
          "name": "rt2 ikut tertolak 401 setelah deteksi reuse",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/refresh",
          "body": {
            "refresh_token": "{{rt2}}"
          },
          "expect_status": [401]
        }
      ]
    },
    {
      "claim_id": "CLAIM-AUTH-REVOKE-01",
      "title": "Pencabutan Sesi (/auth/revoke)",
      "operation": "POST /api/v1/auth/revoke",
      "steps": [
        {
          "name": "Login pengawas_a memperoleh sesi untuk dicabut",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/login",
          "body": {
            "email": "pengawas_a@kopdes-test.local",
            "password": "{{seed_password}}"
          },
          "expect_status": [200],
          "save_json": {
            "rev_acc": "data.access_token",
            "rev_rt": "data.refresh_token"
          }
        },
        {
          "name": "Cabut refresh_token pengawas_a berhasil 200",
          "method": "POST",
          "path": "/api/v1/auth/revoke",
          "token_var": "rev_acc",
          "body": {
            "refresh_token": "{{rev_rt}}"
          },
          "expect_status": [200]
        },
        {
          "name": "Refresh token pasca-revoke ditolak 401",
          "as_account": "unauthenticated",
          "method": "POST",
          "path": "/api/v1/auth/refresh",
          "body": {
            "refresh_token": "{{rev_rt}}"
          },
          "expect_status": [401]
        }
      ]
    },
    {
      "claim_id": "CLAIM-PENDAFTARAN-KYC-01",
      "title": "Pendaftaran NIK, Upload KYC Magic Bytes (PNG 201 / Teks 400), & Masking PII",
      "operation": "POST /api/v1/pendaftaran + /dokumen + GET /pendaftaran/{id}",
      "steps": [
        {
          "name": "Ajukan pendaftaran calon anggota baru",
          "as_account": "operator_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran",
          "body": {
            "nik": "{{new_nik}}",
            "nama_lengkap": "Calon Uji KYC {{unix_ts}}",
            "tempat_lahir": "Bogor",
            "tanggal_lahir": "1995-05-15",
            "jenis_kelamin": "L",
            "pekerjaan": "Petani",
            "alamat_ktp": "Jl. Kopdes Uji No. 10"
          },
          "expect_status": [201],
          "save_json": {
            "pend_kyc_id": "data.pendaftaran_id"
          }
        },
        {
          "name": "Upload file teks palsu ditolak 400 oleh validasi magic bytes",
          "as_account": "operator_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran/{{pend_kyc_id}}/dokumen?jenis_dokumen=ktp",
          "file_field": "file",
          "multipart_csv": "INI_BUKAN_GAMBAR_PNG_OR_PDF",
          "expect_status": [400]
        },
        {
          "name": "Upload gambar PNG valid diterima 201",
          "as_account": "operator_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran/{{pend_kyc_id}}/dokumen?jenis_dokumen=ktp",
          "file_field": "file",
          "multipart_png": true,
          "expect_status": [201],
          "expect_json_contains": ["checksum_sha256", "image/png"]
        },
        {
          "name": "Detail pendaftaran mengembalikan nik_masked & pendaftaran_id",
          "as_account": "pengawas_a",
          "method": "GET",
          "path": "/api/v1/pendaftaran/{{pend_kyc_id}}",
          "expect_status": [200],
          "expect_json_contains": ["nik_masked", "pendaftaran_id", "*"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-PENDAFTARAN-CHECKER-01",
      "title": "Maker-Checker Verifikasi Pendaftaran & Penerbitan no_anggota",
      "operation": "POST /api/v1/pendaftaran/{id}/verifikasi",
      "steps": [
        {
          "name": "pengurus_a mengajukan pendaftaran (sebagai maker)",
          "as_account": "pengurus_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran",
          "body": {
            "nik": "{{new_nik}}",
            "nama_lengkap": "Calon MakerChecker {{unix_ts}}",
            "tempat_lahir": "Bandung",
            "tanggal_lahir": "1994-03-10",
            "jenis_kelamin": "P",
            "pekerjaan": "Pedagang",
            "alamat_ktp": "Jl. Merdeka Kopdes No. 22"
          },
          "expect_status": [201],
          "save_json": {
            "pend_chk_id": "data.pendaftaran_id"
          }
        },
        {
          "name": "Self-approve oleh pengurus_a ditolak 403",
          "as_account": "pengurus_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran/{{pend_chk_id}}/verifikasi",
          "body": {
            "status": "disetujui"
          },
          "expect_status": [403]
        },
        {
          "name": "Approval oleh pengurus2_a berhasil 200 dan menerbitkan no_anggota",
          "as_account": "pengurus2_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran/{{pend_chk_id}}/verifikasi",
          "body": {
            "status": "disetujui"
          },
          "expect_status": [200],
          "expect_json_contains": ["no_anggota", "disetujui"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-PENDAFTARAN-PURGE-01",
      "title": "Purge Pendaftaran Ditolak UU PDP (pengurus/admin 200, non-berwenang 403)",
      "operation": "POST /api/v1/pendaftaran/purge-ditolak",
      "steps": [
        {
          "name": "anggota_a ditolak 403",
          "as_account": "anggota_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran/purge-ditolak",
          "body": {},
          "expect_status": [403]
        },
        {
          "name": "bendahara_a ditolak 403",
          "as_account": "bendahara_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran/purge-ditolak",
          "body": {},
          "expect_status": [403]
        },
        {
          "name": "pengurus_a berhasil menjalankan purge-ditolak 200",
          "as_account": "pengurus_a",
          "method": "POST",
          "path": "/api/v1/pendaftaran/purge-ditolak",
          "body": {},
          "expect_status": [200],
          "expect_json_contains": ["jumlah_dibersihkan", "PERLU VERIFIKASI HUKUM"]
        }
      ]
    },
    {
      "claim_id": "CLAIM-ANGGOTA-RBAC-01",
      "title": "Pemisahan RBAC Anggota: Read-Only pengawas/operator vs Mutasi Status",
      "operation": "GET /anggota + PATCH /anggota/{id}/status",
      "steps": [
        {
          "name": "pengawas_a dapat melihat daftar anggota 200",
          "as_account": "pengawas_a",
          "method": "GET",
          "path": "/api/v1/anggota",
          "expect_status": [200]
        },
        {
          "name": "operator_a dapat melihat detail anggota 200",
          "as_account": "operator_a",
          "method": "GET",
          "path": "/api/v1/anggota/{{anggota_a_id}}",
          "expect_status": [200]
        },
        {
          "name": "anggota_a ditolak mengakses daftar anggota 403",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/anggota",
          "expect_status": [403]
        },
        {
          "name": "bendahara_a ditolak mutasi status anggota 403",
          "as_account": "bendahara_a",
          "method": "PATCH",
          "path": "/api/v1/anggota/{{anggota_a_id}}/status",
          "body": {
            "status": "aktif",
            "alasan": "Uji RBAC"
          },
          "expect_status": [403]
        },
        {
          "name": "operator_a ditolak mutasi status anggota 403",
          "as_account": "operator_a",
          "method": "PATCH",
          "path": "/api/v1/anggota/{{anggota_a_id}}/status",
          "body": {
            "status": "aktif",
            "alasan": "Uji RBAC"
          },
          "expect_status": [403]
        }
      ]
    },
    {
      "claim_id": "CLAIM-USERS-ESCALATION-01",
      "title": "Anti-Self-Change dan Anti-Privilege-Escalation pada PATCH /users/{id}/role",
      "operation": "PATCH /api/v1/users/{id}/role",
      "steps": [
        {
          "name": "Ambil user_id pengurus_a",
          "as_account": "pengurus_a",
          "method": "GET",
          "path": "/api/v1/auth/me",
          "expect_status": [200],
          "save_json": {
            "uid_pengurus_a": "data.user_id"
          }
        },
        {
          "name": "Ambil user_id operator_a",
          "as_account": "operator_a",
          "method": "GET",
          "path": "/api/v1/auth/me",
          "expect_status": [200],
          "save_json": {
            "uid_operator_a": "data.user_id"
          }
        },
        {
          "name": "pengurus_a dilarang mengubah perannya sendiri (403)",
          "as_account": "pengurus_a",
          "method": "PATCH",
          "path": "/api/v1/users/{{uid_pengurus_a}}/role",
          "body": {
            "role": "pengurus"
          },
          "expect_status": [403]
        },
        {
          "name": "pengurus_a dilarang menaikkan operator ke admin di atas perannya (403)",
          "as_account": "pengurus_a",
          "method": "PATCH",
          "path": "/api/v1/users/{{uid_operator_a}}/role",
          "body": {
            "role": "admin"
          },
          "expect_status": [403]
        }
      ]
    },
    {
