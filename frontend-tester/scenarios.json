          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/iuran/tagihan/saya",
          "expect_status": [200]
        },
        {
          "name": "Buat jenis iuran baru mengembalikan KEPUTUSAN AKUNTAN",
          "as_account": "pengurus_a",
          "method": "POST",
          "path": "/api/v1/iuran/jenis",
          "body": {
            "kode": "IUR-{{unix_ts}}",
            "nama": "Iuran Skenario {{unix_ts}}",
            "tipe": "wajib",
