    {
      "claim_id": "CLAIM-KATALOG-TOKO-01",
      "title": "Katalog, Harga Anggota (produk_id+anggota_id wajib, 404 lintas tenant), Keranjang, Checkout & Batal",
      "operation": "GET /katalog/harga + POST /toko/keranjang + /checkout + /batal",
      "steps": [
        {
          "name": "List produk katalog oleh anggota_a",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/katalog/produk",
          "expect_status": [200]
        },
        {
          "name": "Cek harga tanpa parameter anggota_id ditolak 400",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/katalog/harga?produk_id={{produk_a_id}}",
          "expect_status": [400]
        },
        {
          "name": "Cek harga anggota Kop A pada produk Kop A valid 200",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/katalog/harga?produk_id={{produk_a_id}}&anggota_id={{anggota_a_id}}",
          "expect_status": [200]
        },
        {
          "name": "Cek harga produk Kop B lintas tenant mengembalikan 404 (RLS)",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/katalog/harga?produk_id={{produk_b_id}}&anggota_id={{anggota_b_id}}",
          "expect_status": [404]
        },
        {
          "name": "Cek harga produk Kop A dengan anggota_id Kop B hanya beri harga umum (berhak_harga_anggota=false)",
          "as_account": "anggota_a",
          "method": "GET",
          "path": "/api/v1/katalog/harga?produk_id={{produk_a_id}}&anggota_id={{anggota_b_id}}",
          "expect_status": [200],
          "expect_json_contains": ["\"berhak_harga_anggota\":false"]
